# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_SHUTDOWN_TIMEOUT=30s

# Database
DB_PATH=./data/waste_dispatch.db
DB_MIGRATIONS_PATH=file://migrations
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

# Auth
AUTH_TOKEN_SECRET=change-me-to-a-long-random-secret-in-production
AUTH_TOKEN_EXPIRY=24h
AUTH_SESSION_EXPIRY=168h

# Logging
LOG_LEVEL=info
LOG_PRETTY=false
